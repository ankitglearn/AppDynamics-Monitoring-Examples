<monitor>
    <name>secureagentmonitor</name>
    <type>managed</type>
    <description>Custom monitor to check if app is READY</description>
    <monitor-configuration>
    </monitor-configuration>
    <monitor-run-task>
        <execution-style>periodic</execution-style>
        <execution-frequency-in-seconds>60</execution-frequency-in-seconds>
        <name>Run</name>
        <type>executable</type>
        <task-arguments></task-arguments>
        <executable-task>
            <type>file</type>
            <file>checkSecureAgentStatus.sh</file>
        </executable-task>
    </monitor-run-task>
</monitor>